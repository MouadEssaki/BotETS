# Copier vers .env (ne pas committer .env)

LOG_LEVEL=INFO
TIMEZONE=America/Montreal

# --- Notifications téléphone (au moins un des deux) ---

# Option A : ntfy (gratuit, app iOS/Android « ntfy »)
# 1. Installez l'app ntfy sur votre téléphone
# 2. Abonnez-vous à un topic secret (ex. botets-votre-prenom-12345)
# 3. Collez le même topic ici :
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_PRIORITY=urgent